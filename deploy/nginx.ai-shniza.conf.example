# Example nginx reverse proxy for {AI}-шница (TLS terminates here).
# Place under /etc/nginx/sites-available/ and enable.
#
# upstream ai_shniza {
#     server 127.0.0.1:8000;
# }
#
# server {
#     listen 443 ssl http2;
#     server_name example.com;
#     # ssl_certificate ...;
#     # ssl_certificate_key ...;
#
#     client_max_body_size 32m;
#
#     location / {
#         proxy_pass http://ai_shniza;
#         proxy_set_header Host $host;
#         proxy_set_header X-Real-IP $remote_addr;
#         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#         proxy_set_header X-Forwarded-Proto $scheme;
#         proxy_read_timeout 120s;
#     }
# }

upstream ai_shniza {
    server 127.0.0.1:8000;
    keepalive 8;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 32m;

    # Скрепка студии: видео до 100 МБ (UPLOAD_MAX_VIDEO_MB) + запас на multipart
    location = /api/uploads {
        client_max_body_size 110m;
        proxy_request_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass http://ai_shniza;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass http://ai_shniza;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
