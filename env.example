# Copy to .env and fill in. Never commit real secrets.

FLASK_ENV=development
FLASK_DEBUG=0
PORT=8000
SECRET_KEY=replace-with-long-random-string

# Comma-separated browser origins allowed for CORS + credentials
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# production | development — Secure cookies + HSTS when production
# SESSION_COOKIE_SECURE=1
# ENABLE_HSTS=1

REDIS_URL=redis://127.0.0.1:6379/0

GENERATE_USE_QUEUE=1
# GENERATE_SYNC_WAIT=1      # debug only — blocks gunicorn worker until job finishes
# JOB_WAIT_SEC=360
# JOB_QUEUE_MAX_SEC=1800
# CHAT_DEADLINE_SEC=45
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=8
# GUNICORN_TIMEOUT=60

# Channel worker concurrency (threads per process)
# WORKER_CONCURRENCY_REPLICATE=10
# WORKER_CONCURRENCY_FAL=6
# WORKER_CONCURRENCY_OMNIROUTE=3
# WORKER_SHUTDOWN_GRACE_SEC=20

# Provider API keys (never commit real values)
# REPLICATE_API_TOKEN=
# FAL_KEY=
# GROQ_API_KEY=

REGION=RU

# OmniRoute chat
# OMNIROUTE_BASE_URL=http://127.0.0.1:20128
# OMNIROUTE_API_KEY=
# OMNIROUTE_CHAT_MODEL=auto/coding:free

# Admin
# ADMIN_EMAILS=you@example.com

# Robokassa (step 8)
# ROBOKASSA_MERCHANT_LOGIN=
# ROBOKASSA_PASSWORD1=
# ROBOKASSA_PASSWORD2=
# ROBOKASSA_TEST=1
# DOMAIN=ai-shniza.ru

# Object storage (optional; local media/ fallback)
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_REGION=ru-central1
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Login code email
# Prefer HTTPS (works when home Wi‑Fi blocks SMTP 465/587):
# RESEND_API_KEY=re_xxx
# RESEND_FROM=onboarding@resend.dev
# Or Yandex SMTP (needs open outbound SMTP — often blocked on home networks):
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=you@yandex.ru
# MAIL_FROM=you@yandex.ru
# MAIL_PASS=
# MAIL_FROM_NAME={AI}-шница
# SMTP_TIMEOUT=8

# Free video dispatcher
# FREE_VIDEO_MODEL=veo-free/seedance
# FREE_STUB=1
# ALLOW_STUB_GEN=1

# Ассистент чата: LLM нужна только для адаптации промпта, остальное — правила
# ASSIST_LLM_ORDER=groq,omniroute
# ASSIST_GROQ_MODEL=llama-3.1-8b-instant
# ASSIST_OMNIROUTE_MODEL=
# ASSIST_LLM_DEADLINE_SEC=12
# ASSIST_OMNIROUTE_TIMEOUT=7
# ASSIST_GROQ_TIMEOUT=5
# ASSIST_LLM_MAX_TOKENS=220
# ASSIST_SESSION_TOKEN_BUDGET=6000
# ASSIST_VITRINA_URL=/explore
