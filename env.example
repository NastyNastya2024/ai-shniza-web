# Copy to .env and fill in. Never commit real secrets.

FLASK_ENV=development
FLASK_DEBUG=0
PORT=8000
SECRET_KEY=replace-with-long-random-string

# Comma-separated browser origins allowed for CORS + credentials
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# production | development — Secure cookies + HSTS when production
# SESSION_COOKIE_SECURE=1
# ENABLE_HSTS=1

REDIS_URL=redis://127.0.0.1:6379/0
REGION=RU

# OmniRoute chat
# OMNIROUTE_BASE_URL=http://127.0.0.1:20128
# OMNIROUTE_API_KEY=
# OMNIROUTE_CHAT_MODEL=auto/coding:free

# Admin
# ADMIN_EMAILS=you@example.com

# Robokassa (step 8)
# ROBOKASSA_MERCHANT_LOGIN=
# ROBOKASSA_PASSWORD1=
# ROBOKASSA_PASSWORD2=
# ROBOKASSA_TEST=1
# DOMAIN=ai-shniza.ru

# Object storage (optional; local media/ fallback)
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_REGION=ru-central1
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Free video dispatcher
# FREE_VIDEO_MODEL=veo-free/seedance
# FREE_STUB=1
# ALLOW_STUB_GEN=1
